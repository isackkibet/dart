# Host
ANNOUNCED_IP=192.168.1.10
LAN_IP=192.168.1.10

# Ports
API_PORT=3000
WS_PORT=3001
NGINX_HTTPS_PORT=443
TURN_PORT=3478
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# Auth
JWT_SECRET=change-me-local-secret

# TURN
TURN_USERNAME=localuser
TURN_PASSWORD=localpass
TURN_REALM=localhost

# mediasoup
MEDIASOUP_LOG_LEVEL=warn

# YohPal Mesh Live v1.0.2
MESH_CONTROL_PORT=8080
AUTH_MODE=firebase
PERSISTENCE_MODE=firestore
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
PAIRING_SECRET=replace-with-at-least-32-random-bytes
SFU_CONTROL_TOKEN=replace-with-private-service-token
SFU_CONTROL_URL=http://mediasoup:3000
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"replace","credential":"replace"}]
