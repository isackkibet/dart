{
  "name": "yohpal-admin-web",
  "version": "2.0.0-admin-gap-fix",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:admin": "npm run typecheck && tsx scripts/admin_route_inventory.ts",
    "smoke:admin": "tsx scripts/admin_smoke_tests.ts",
    "seed:staging-admins": "tsx scripts/seed_staging_admins.ts",
    "seed:staging-queues": "tsx scripts/seed_admin_test_queues.ts",
