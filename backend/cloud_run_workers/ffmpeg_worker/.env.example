# Example environment variables for the FFmpeg worker
# Copy this file to .env and adjust values for your deployment.

# Google Cloud project ID (for Firestore)
FIRESTORE_PROJECT_ID=your-gcp-project-id

# Name of the Cloud Storage bucket used for media assets
GCS_BUCKET_NAME=yohpal-live-media

# Poll interval in seconds (default 10)
WORKER_POLL_INTERVAL_SECONDS=10

# Maximum concurrent jobs per container instance (default 2)
MAX_CONCURRENT_JOBS=2

# Temporary working directory inside the container (must be writable)
TEMP_DIR=/tmp/yohpal_worker

# Optional: set the hostname for claim logging
# HOSTNAME=$(hostname)
